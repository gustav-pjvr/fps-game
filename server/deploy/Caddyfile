# TLS front for the relay. setup.sh installs this as /etc/caddy/Caddyfile and writes
# HNG_DOMAIN (for example <name>.duckdns.org) into /etc/hng-caddy.env, which a systemd drop-in
# hands to caddy.service. Caddy gets and renews the Let's Encrypt certificate by itself (it needs
# TCP 80 and 443 reachable from the internet).
#
# If this name is ever proxied by Cloudflare (orange cloud), every connection reaches Caddy from a
# Cloudflare address: add `trusted_proxies static <Cloudflare's published ranges>` under `servers`
# in the global options and send `header_up X-Forwarded-For {client_ip}` below instead of
# {remote_host}, or the relay's per-IP limits count every player as one (design section 8.1).
{
	# The admin API on a unix socket that only root and the caddy user can write to, not on TCP
	# localhost:2019 where any local process could reach it. The drop-in caddy-hng.conf creates
	# /run/caddy and points `systemctl reload caddy` at this socket.
	admin unix//run/caddy/admin.sock|0220
}

{$HNG_DOMAIN} {
	reverse_proxy 127.0.0.1:8080 {
		# The relay trusts X-Forwarded-For only from 127.0.0.1 and reads the LAST entry, so
		# replace whatever the client sent with the one address Caddy saw.
		header_up X-Forwarded-For {remote_host}
		# WebSocket upgrades (/ws) pass through without extra settings. Do not buffer them.
		flush_interval -1
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
}
